fn fact(n) {
    if (n <= 1) { return 1; } else { return n * fact(n - 1); }
}
fn fib(n) {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
}
print(fact(5));
print(fib(10));

