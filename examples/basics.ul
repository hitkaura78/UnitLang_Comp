// Basic UnitLang demo: dimensional arithmetic + smart print formatting.

qty distance = 100 * m;
qty sprintTime = 9.58 * s;
qty speed = distance / sprintTime;
print(speed);                     // Length/Time, base units

qty raceLength = 2 * hr + 30 * min;   // both operands are Time: OK
print(raceLength);                    // should display nicely as hours

qty mass = 5 * kg;
qty accel = 9.8 * m / s ^ 2;
qty force = mass * accel;
print(force);

qty far = 5000 * m;
print(far);                       // smart-format picks whichever unit
                                   // lands closest to magnitude 1 (mi, here)
